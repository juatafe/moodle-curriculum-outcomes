        <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="assessuser" UNIQUE="true" FIELDS="assessmentid, userid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_crout_importbatch" COMMENT="Course curriculum import audit batches">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="frameworkid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="30" NOTNULL="true"/>
        <FIELD NAME="sourceid" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="curriculumkey" TYPE="char" LENGTH="255" NOTNULL="true"/>
