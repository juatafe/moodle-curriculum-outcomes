    <TABLE NAME="local_crout_checklist_map" COMMENT="Checklist item to curriculum criterion mapping">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
