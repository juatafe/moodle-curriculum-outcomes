        <KEY NAME="itemfk" TYPE="foreign" FIELDS="itemid" REFTABLE="local_crout_checklist_item" REFFIELDS="id"/>
        <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="graderfk" TYPE="foreign" FIELDS="graderid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="defitemuser" UNIQUE="true" FIELDS="definitionid, itemid, userid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_crout_judgement" COMMENT="Manual current judgement per criterion per student">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="criterionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="scalevalue" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="comment" TYPE="text" NOTNULL="false"/>
